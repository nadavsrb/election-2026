---
import Base from '../../layouts/Base.astro';
import { parties, polls } from '../../lib/data';
import { formatSourceDate } from '../../lib/scoring';
import { POLL_BAN_LABEL, POLL_NOTE, url } from '../../lib/site';

// Same alphabetical order as the party directory.
const rows = [...parties].sort((a, b) => a.short_name.localeCompare(b.short_name, 'he'));
const cell = (n: number | null | undefined) => (typeof n !== 'number' ? 'לא דווח' : n === 0 ? 'מתחת לחסימה' : String(n));
const others = (p: (typeof polls)[number]) =>
  Object.entries(p.other)
    .filter(([, n]) => n > 0)
    .map(([name, n]) => `${name} ${n}`)
    .join(', ') || '—';
const hasOthers = polls.some((p) => Object.values(p.other).some((n) => n > 0));
---
<Base
  title="הסקרים האחרונים לפני האיסור"
  description="מספרי המושבים של כל רשימה בסקרים האחרונים שפורסמו לפני האיסור על פרסום סקרים חדשים, עם קישור לכל סקר."
>
  <article class="wrap-narrow pt-10 pb-14 prose-he polls-page">
    <h1 class="page-title">הסקרים האחרונים לפני האיסור</h1>
    <p class="polls-note" role="note">
      <strong>{POLL_NOTE}</strong> מ{POLL_BAN_LABEL} ועד סגירת הקלפיות החוק אוסר לפרסם סקרי בחירות חדשים. מותר להציג
      סקרים שפורסמו לפני כן, בתנאי שמציינים שהם אינם עדכניים.
    </p>

    <h2>איך נבחרו הסקרים</h2>
    <p>
      מכל כלי תקשורת מרכזי לקחנו את הסקר האחרון שפרסם בשבוע שלפני האיסור, בין 16 ל-23 באוקטובר, בלי קשר לתוצאות. המספרים
      מועתקים כפי שפורסמו, ובכל סקר סכום המושבים הוא 120. "מתחת לחסימה" פירושו שבאותו סקר הרשימה לא עברה את אחוז החסימה,
      3.25% מהקולות הכשרים. הסקרים לא משפיעים על אחוז ההתאמה בשאלון, ואנחנו לא מחשבים מהם תחזיות או הסתברויות.
    </p>

    {polls.length === 0 ? (
      <p>עדיין לא הוספנו סקרים.</p>
    ) : (
      <>
        <div class="table-scroll" tabindex="0" role="region" aria-label="טבלת הסקרים">
          <table>
            <caption class="sr-only">מספר המושבים של כל רשימה בכל סקר</caption>
            <thead>
              <tr>
                <th scope="col">רשימה</th>
                {polls.map((p) => (
                  <th scope="col">
                    {p.outlet}
                    <span class="col-date">{formatSourceDate(p.date)}</span>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rows.map((party) => (
                <tr>
                  <th scope="row">
                    <a href={url(`parties/${party.id}/#polls`)}>{party.short_name}</a>
                  </th>
                  {polls.map((p) => (
                    <td class={p.seats[party.id] === 0 ? 'below' : undefined}>{cell(p.seats[party.id])}</td>
                  ))}
                </tr>
              ))}
              {hasOthers && (
                <tr>
                  <th scope="row">רשימות אחרות</th>
                  {polls.map((p) => <td>{others(p)}</td>)}
                </tr>
              )}
            </tbody>
          </table>
        </div>

        <h2>הסקרים והמקורות</h2>
        <ul class="poll-sources">
          {polls.map((p) => (
            <li>
              <a class="source-link" href={p.url} target="_blank" rel="noopener noreferrer">{p.title}</a>
              <span class="meta">
                {[p.outlet, p.pollster && `סוקר: ${p.pollster}`, formatSourceDate(p.date)].filter(Boolean).join(', ')}
              </span>
            </li>
          ))}
        </ul>
      </>
    )}
  </article>
</Base>

<style>
  .page-title { font-size: clamp(2.1rem, 8vw, 3rem); font-weight: 900; }
  .polls-page h2 { font-size: clamp(1.45rem, 5vw, 1.8rem); font-weight: 900; margin-top: 2.5rem; }
  .polls-note {
    margin-top: 1rem;
    padding: 0.85rem 1.1rem;
    border-inline-start: 4px solid var(--color-accent);
    background: var(--color-sunken);
    border-start-end-radius: var(--radius-panel);
    border-end-end-radius: var(--radius-panel);
  }
  .table-scroll {
    margin-top: 1.5rem;
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-panel);
  }
  .table-scroll:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }
  table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  th, td { padding: 0.55rem 0.7rem; border-bottom: 1px solid var(--color-line); text-align: center; white-space: nowrap; }
  thead th { background: var(--color-sunken); font-weight: 700; vertical-align: bottom; }
  tbody th { text-align: start; font-weight: 600; }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  td { font-variant-numeric: tabular-nums; }
  td.below { color: var(--color-ink-soft); font-size: 0.82rem; }
  .col-date { display: block; font-weight: 500; font-size: 0.8rem; color: var(--color-ink-soft); }
  .poll-sources { margin-top: 0.8rem; display: grid; gap: 0.6rem; }
  .poll-sources .meta { display: block; font-size: 0.88rem; color: var(--color-ink-soft); }
</style>
