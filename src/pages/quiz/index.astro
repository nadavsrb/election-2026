---
import Base from '../../layouts/Base.astro';
import Quiz from '../../components/quiz/Quiz';
import '../../styles/quiz.css';
import { url } from '../../lib/site';
---
<Base
  title="השאלון"
  description="שאלון קצר על הנושאים שעל סדר היום, שמראה אילו רשימות קרובות לעמדות שלכם, עם מקור לכל עמדה. בלי הרשמה ובלי מעקב."
  bare
>
  <Quiz client:load dataUrl={url('data/quiz.json')} baseUrl={url()} />
  <noscript>
    <div class="wrap-narrow py-10">
      <p>השאלון דורש JavaScript. אפשר לקרוא את עמדות הרשימות גם בלעדיו, בעמוד <a href={url('parties/')}>המפלגות</a>.</p>
    </div>
  </noscript>
</Base>
